<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_trace_evidence_tree" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.tree</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <list string="留痕证据">
                <field name="uploaded_at"/>
                <field name="name"/>
                <field name="trace_event_id"/>
                <field name="waybill_id"/>
                <field name="uploader_id"/>
                <field name="image_count"/>
                <field name="match_status"/>
                <field name="link_status"/>
                <field name="is_exception_related"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_form" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.form</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <form string="留痕证据">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="trace_event_id"/>
                            <field name="waybill_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                            <field name="matched_waybill_id"/>
                            <field name="matched_customer_line_id"/>
                            <field name="uploaded_at"/>
                        </group>
                        <group>
                            <field name="uploader_id"/>
                            <field name="uploader_name" readonly="1"/>
                            <field name="sequence"/>
                            <field name="state"/>
                            <field name="match_status"/>
                            <field name="link_status"/>
                            <field name="linked_at" readonly="1"/>
                            <field name="linked_by" readonly="1"/>
                            <field name="image_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="封面图兼容字段">
                            <field name="image_access_key"/>
                            <field name="preview_url"/>
                            <field name="full_url"/>
                        </group>
                        <group string="证据上下文">
                            <field name="is_exception_related" readonly="1"/>
                            <field name="remark"/>
                            <field name="match_remark"/>
                        </group>
                    </group>
                    <group string="图片列表" col="1">
                        <field name="image_ids" readonly="1">
                            <list create="0" delete="0">
                                <field name="sequence"/>
                                <field name="image_access_key"/>
                                <field name="source_filename"/>
                                <field name="storage_provider"/>
                                <field name="storage_status"/>
                                <field name="preview_url" widget="url"/>
                                <field name="download_url" widget="url"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_search" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.search</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <search string="留痕证据">
                <field name="name"/>
                <field name="trace_event_id"/>
                <field name="waybill_id"/>
                <field name="image_access_key"/>
                <filter string="异常相关" name="exception_related" domain="[('is_exception_related', '=', True)]"/>
                <filter string="待人工复核" name="manual_review" domain="[('link_status', '=', 'manual_review')]"/>
                <group>
                    <filter string="按运单" name="group_waybill" context="{'group_by': 'waybill_id'}"/>
                    <filter string="按留痕事件" name="group_trace" context="{'group_by': 'trace_event_id'}"/>
                    <filter string="按上传人" name="group_uploader" context="{'group_by': 'uploader_id'}"/>
                    <filter string="按补链状态" name="group_link_status" context="{'group_by': 'link_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_trace_evidence" model="ir.actions.act_window">
        <field name="name">留痕证据</field>
        <field name="res_model">logistics.trace.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_search"/>
    </record>

    <menuitem
        id="menu_logistics_trace_evidence"
        name="留痕证据"
        parent="logistics_dispatch.menu_logistics_dispatch"
        action="action_logistics_trace_evidence"
        sequence="50"/>

    <record id="view_logistics_dispatch_waybill_form_inherit_trace_evidence" model="ir.ui.view">
        <field name="name">logistics.dispatch.waybill.form.trace.evidence</field>
        <field name="model">logistics.dispatch.waybill</field>
        <field name="inherit_id" ref="logistics_dispatch.view_logistics_dispatch_waybill_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[@name='action_open_goods_lines']" position="after">
                <button
                    name="action_open_evidences"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-image">
                    <field name="evidence_count" string="证据" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='open_exception_count']" position="after">
                <field name="latest_evidence_time" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
