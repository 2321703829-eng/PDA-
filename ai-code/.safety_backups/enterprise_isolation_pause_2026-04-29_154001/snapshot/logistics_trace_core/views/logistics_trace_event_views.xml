<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_trace_event_tree" model="ir.ui.view">
        <field name="name">logistics.trace.event.tree</field>
        <field name="model">logistics.trace.event</field>
        <field name="arch" type="xml">
            <list string="留痕事件">
                <field name="trace_time"/>
                <field name="event_type"/>
                <field name="object_type"/>
                <field name="waybill_id"/>
                <field name="batch_id"/>
                <field name="submit_user_id"/>
                <field name="evidence_count"/>
                <field name="is_exception"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_event_form" model="ir.ui.view">
        <field name="name">logistics.trace.event.form</field>
        <field name="model">logistics.trace.event</field>
        <field name="arch" type="xml">
            <form string="留痕事件">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="trace_time"/>
                            <field name="event_type"/>
                            <field name="object_type"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="submit_user_id"/>
                            <field name="submit_source"/>
                            <field name="evidence_count"/>
                            <field name="is_exception"/>
                        </group>
                    </group>
                    <group>
                        <group string="留痕上下文">
                            <field name="waybill_id" invisible="object_type != 'waybill'"/>
                            <field name="batch_id"/>
                            <field name="location_text"/>
                            <field name="source_channel"/>
                            <field name="source_record_id"/>
                        </group>
                        <group string="执行上下文">
                            <field name="plate_no"/>
                            <field name="driver_name"/>
                            <field name="submit_user_name" readonly="1"/>
                        </group>
                    </group>
                    <group string="备注">
                        <field name="remark" placeholder="填写现场事实或本次留痕说明。"/>
                    </group>
                    <field name="message_follower_ids" invisible="1"/>
                    <field name="activity_ids" invisible="1"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_event_search" model="ir.ui.view">
        <field name="name">logistics.trace.event.search</field>
        <field name="model">logistics.trace.event</field>
        <field name="arch" type="xml">
            <search string="留痕事件">
                <field name="name"/>
                <field name="event_type"/>
                <field name="waybill_id"/>
                <field name="batch_id"/>
                <field name="submit_user_id"/>
                <filter string="运单留痕" name="waybill_events" domain="[('object_type', '=', 'waybill')]"/>
                <filter string="批次留痕" name="batch_events" domain="[('object_type', '=', 'batch')]"/>
                <filter string="异常关联留痕" name="exception_events" domain="[('is_exception', '=', True)]"/>
                <group>
                    <filter string="按事件类型" name="group_event_type" context="{'group_by': 'event_type'}"/>
                    <filter string="按运单" name="group_waybill" context="{'group_by': 'waybill_id'}"/>
                    <filter string="按批次" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="按提交人" name="group_submitter" context="{'group_by': 'submit_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_trace_event" model="ir.actions.act_window">
        <field name="name">留痕事件</field>
        <field name="res_model">logistics.trace.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_event_search"/>
    </record>

    <menuitem
        id="menu_logistics_trace_event"
        name="留痕事件"
        parent="logistics_dispatch.menu_logistics_dispatch"
        action="action_logistics_trace_event"
        groups="logistics_trace_core.group_logistics_trace_event_manager"
        sequence="40"/>

    <record id="view_logistics_dispatch_waybill_form_inherit_trace_core" model="ir.ui.view">
        <field name="name">logistics.dispatch.waybill.form.trace.core</field>
        <field name="model">logistics.dispatch.waybill</field>
        <field name="inherit_id" ref="logistics_dispatch.view_logistics_dispatch_waybill_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[last()]" position="after">
                <button
                    name="action_open_trace_events"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-stream">
                    <field name="trace_count" string="留痕事件" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
