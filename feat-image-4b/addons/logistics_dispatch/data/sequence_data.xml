<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_logistics_dispatch_wave" model="ir.sequence">
        <field name="name">Dispatch Wave</field>
        <field name="code">logistics.dispatch.wave</field>
        <field name="prefix">WV%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_logistics_dispatch_batch" model="ir.sequence">
        <field name="name">Dispatch Batch</field>
        <field name="code">logistics.dispatch.batch</field>
        <field name="prefix">BT%(y)s%(month)s%(day)s-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_logistics_dispatch_waybill" model="ir.sequence">
        <field name="name">Dispatch Waybill</field>
        <field name="code">logistics.dispatch.waybill</field>
        <field name="prefix">WB%(y)s%(month)s%(day)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
