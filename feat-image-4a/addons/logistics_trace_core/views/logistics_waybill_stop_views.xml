<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_waybill_stop_tree" model="ir.ui.view">
        <field name="name">logistics.waybill.stop.tree</field>
        <field name="model">logistics.waybill.stop</field>
        <field name="arch" type="xml">
            <tree>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="stop_seq"/>
                <field name="store_name"/>
                <field name="address"/>
                <field name="contact_name"/>
                <field name="contact_phone"/>
                <field name="driver_name"/>
                <field name="vehicle_no"/>
            </tree>
        </field>
    </record>

    <record id="view_logistics_waybill_stop_form" model="ir.ui.view">
        <field name="name">logistics.waybill.stop.form</field>
        <field name="model">logistics.waybill.stop</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="waybill_no"/>
                            <field name="batch_no"/>
                            <field name="stop_seq"/>
                            <field name="store_name"/>
                            <field name="address"/>
                            <field name="partner_id"/>
                            <field name="stock_picking_id"/>
                        </group>
                        <group>
                            <field name="lat"/>
                            <field name="lng"/>
                            <field name="contact_name"/>
                            <field name="contact_phone"/>
                            <field name="guide_url"/>
                            <field name="driver_name"/>
                            <field name="vehicle_no"/>
                        </group>
                    </group>
                    <group>
                        <field name="goods_info"/>
                        <field name="contact_list_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_waybill_stop_search" model="ir.ui.view">
        <field name="name">logistics.waybill.stop.search</field>
        <field name="model">logistics.waybill.stop</field>
        <field name="arch" type="xml">
            <search>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="store_name"/>
                <field name="driver_name"/>
                <field name="vehicle_no"/>
                <filter name="group_waybill" string="Waybill" context="{'group_by': 'waybill_no'}"/>
            </search>
        </field>
    </record>

    <record id="action_logistics_waybill_stop" model="ir.actions.act_window">
        <field name="name">Waybill Stops</field>
        <field name="res_model">logistics.waybill.stop</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_logistics_waybill_stop_search"/>
    </record>
</odoo>
