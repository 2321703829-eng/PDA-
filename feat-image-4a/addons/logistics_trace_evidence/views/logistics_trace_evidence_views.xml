<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_trace_evidence_tree" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.tree</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="biz_type"/>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="evidence_type"/>
                <field name="state"/>
                <field name="trace_id"/>
                <field name="image_count"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_search" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.search</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="trace_id"/>
                <filter string="Waybill" name="filter_waybill" domain="[('biz_type', '=', 'waybill')]"/>
                <filter string="Batch" name="filter_batch" domain="[('biz_type', '=', 'batch')]"/>
                <filter string="OK" name="filter_ok" domain="[('state', '=', 'ok')]"/>
                <group expand="0" string="Group By">
                    <filter string="Business Type" name="group_biz_type" context="{'group_by': 'biz_type'}"/>
                    <filter string="Evidence Type" name="group_evidence_type" context="{'group_by': 'evidence_type'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_form" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.form</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <form string="Trace Evidence">
                <header>
                    <button name="action_open_upload_wizard" type="object" string="Upload Image" class="btn-secondary"/>
                    <button name="action_open_images" type="object" string="Open Images" class="btn-secondary" invisible="image_count == 0"/>
                    <button name="action_sync_all_image_meta" type="object" string="Sync Image Metadata" class="btn-secondary" invisible="image_count == 0"/>
                    <button name="action_mark_ok" type="object" string="Mark OK" class="btn-primary" invisible="state == 'ok'"/>
                    <button name="action_mark_bad" type="object" string="Mark Bad" invisible="state == 'bad'"/>
                    <button name="action_mark_deleted" type="object" string="Mark Deleted" invisible="state == 'del'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,ok,bad,del"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="evidence_type"/>
                            <field name="trace_id"/>
                            <field name="biz_type" readonly="1"/>
                        </group>
                        <group>
                            <field name="waybill_no" readonly="1" invisible="biz_type != 'waybill'"/>
                            <field name="batch_no" readonly="1" invisible="biz_type != 'batch'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="image_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark"/>
                    </group>
                    <notebook>
                        <page string="Images">
                            <field name="image_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="waybill_no" readonly="1" column_invisible="parent.biz_type != 'waybill'"/>
                                    <field name="batch_no" readonly="1" column_invisible="parent.biz_type != 'batch'"/>
                                    <field name="image_access_key"/>
                                    <field name="source_filename"/>
                                    <field name="stored_file_name"/>
                                    <field name="mime_type"/>
                                    <field name="file_size"/>
                                    <field name="storage_provider"/>
                                    <field name="storage_status"/>
                                    <field name="captured_at"/>
                                    <button name="action_open_preview" type="object" string="Preview" icon="fa-external-link"/>
                                    <button name="action_open_download" type="object" string="Download" icon="fa-download"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_image_tree" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.image.tree</field>
        <field name="model">logistics.trace.evidence.image</field>
        <field name="arch" type="xml">
            <list>
                <field name="evidence_id"/>
                <field name="biz_type"/>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="image_access_key"/>
                <field name="source_filename"/>
                <field name="stored_file_name"/>
                <field name="mime_type"/>
                <field name="file_size"/>
                <field name="storage_provider"/>
                <field name="storage_status"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_image_search" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.image.search</field>
        <field name="model">logistics.trace.evidence.image</field>
        <field name="arch" type="xml">
            <search>
                <field name="image_access_key"/>
                <field name="waybill_no"/>
                <field name="batch_no"/>
                <field name="storage_status"/>
                <field name="evidence_id"/>
                <filter string="Waybill" name="filter_image_waybill" domain="[('biz_type', '=', 'waybill')]"/>
                <filter string="Batch" name="filter_image_batch" domain="[('biz_type', '=', 'batch')]"/>
                <group expand="0" string="Group By">
                    <filter string="Business Type" name="group_image_biz_type" context="{'group_by': 'biz_type'}"/>
                    <filter string="Storage Status" name="group_image_storage_status" context="{'group_by': 'storage_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_image_form" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.image.form</field>
        <field name="model">logistics.trace.evidence.image</field>
        <field name="arch" type="xml">
            <form string="Evidence Image">
                <header>
                    <button name="action_sync_image_meta" type="object" string="Sync Metadata" class="btn-secondary"/>
                    <button name="action_open_preview" type="object" string="Open Preview" class="btn-secondary"/>
                    <button name="action_open_download" type="object" string="Open Download" class="btn-secondary"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="evidence_id"/>
                            <field name="biz_type" readonly="1"/>
                            <field name="waybill_no" readonly="1" invisible="biz_type != 'waybill'"/>
                            <field name="batch_no" readonly="1" invisible="biz_type != 'batch'"/>
                            <field name="image_access_key" readonly="1"/>
                        </group>
                        <group>
                            <field name="source_filename" readonly="1"/>
                            <field name="stored_file_name" readonly="1"/>
                            <field name="mime_type" readonly="1"/>
                            <field name="file_size" readonly="1"/>
                            <field name="storage_provider" readonly="1"/>
                            <field name="storage_status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="storage_bucket" readonly="1"/>
                        <field name="storage_relative_path" readonly="1"/>
                        <field name="captured_at"/>
                        <field name="remark"/>
                    </group>
                    <group>
                        <field name="preview_url" readonly="1" widget="url"/>
                        <field name="download_url" readonly="1" widget="url"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_event_form_inherit_evidence" model="ir.ui.view">
        <field name="name">logistics.trace.event.form.inherit.evidence</field>
        <field name="model">logistics.trace.event</field>
        <field name="inherit_id" ref="logistics_trace_core.view_logistics_trace_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Evidence">
                        <field name="evidence_ids">
                            <list>
                                <field name="name"/>
                                <field name="evidence_type"/>
                                <field name="state"/>
                                <field name="image_count"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="action_logistics_trace_evidence" model="ir.actions.act_window">
        <field name="name">Evidence</field>
        <field name="res_model">logistics.trace.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_search"/>
    </record>

    <record id="action_logistics_trace_evidence_image" model="ir.actions.act_window">
        <field name="name">Evidence Images</field>
        <field name="res_model">logistics.trace.evidence.image</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_image_search"/>
    </record>

    <menuitem id="menu_logistics_trace_evidence" name="Evidence" parent="logistics_trace_core.menu_logistics_trace_root" action="action_logistics_trace_evidence" sequence="20"/>
    <menuitem id="menu_logistics_trace_evidence_image" name="Evidence Images" parent="logistics_trace_core.menu_logistics_trace_root" action="action_logistics_trace_evidence_image" sequence="30"/>
</odoo>
