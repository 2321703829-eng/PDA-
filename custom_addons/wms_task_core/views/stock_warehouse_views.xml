<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_warehouse_form_wms_task_core" model="ir.ui.view">
        <field name="name">stock.warehouse.form.wms.task.core</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_inventory_ledger"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-book">
                    <field name="inventory_ledger_count" string="Inventory Ledger" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
