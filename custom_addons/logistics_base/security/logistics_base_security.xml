<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_logistics_profile_manager" model="res.groups">
        <field name="name">物流画像配置管理员</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <function model="res.users" name="write">
        <value model="res.users" search="[('id', '=', ref('base.user_admin'))]"/>
        <value eval="{'groups_id': [(4, ref('group_logistics_profile_manager'))]}"/>
    </function>
</odoo>
