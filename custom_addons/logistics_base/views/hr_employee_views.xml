<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_logistics_base" model="ir.ui.view">
        <field name="name">hr.employee.form.logistics.base</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button
                    name="action_open_or_create_driver_profile"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-id-card-o"
                    groups="logistics_base.group_logistics_profile_manager"
                    invisible="logistics_role != 'driver'">
                    <field name="logistics_driver_profile_count" widget="statinfo" string="司机画像"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="物流信息" name="logistics">
                    <group>
                        <group>
                            <field name="logistics_employee_code"/>
                            <field name="logistics_role"/>
                            <field name="logistics_work_status"/>
                            <field name="organization_name"/>
                            <field name="employee_status"/>
                        </group>
                        <group>
                            <field name="logistics_service_area"/>
                            <field name="logistics_default_warehouse_id"/>
                            <field name="logistics_can_take_order"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
