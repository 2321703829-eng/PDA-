<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_trace_evidence_summary_tree" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.summary.tree</field>
        <field name="model">logistics.trace.evidence.summary</field>
        <field name="arch" type="xml">
            <list string="&#30041;&#30165;&#35777;&#25454;&#27719;&#24635;" create="0" edit="0" delete="0">
                <field name="batch_display_text" string="&#25209;&#27425;&#21495;" width="160"/>
                <field name="waybill_no" string="&#36816;&#21333;&#21495;" width="160"/>
                <field name="upload_role" string="&#30041;&#30165;&#31471;" width="90"/>
                <field name="trace_event_count" string="&#30041;&#30165;&#25968;" width="70"/>
                <field name="evidence_count" string="&#35777;&#25454;&#25968;" width="70"/>
                <field name="latest_uploaded_at" string="&#26368;&#26032;&#19978;&#20256;&#26102;&#38388;" width="170"/>
                <field name="thumbnail_html" widget="html" string="&#35777;&#25454;&#32553;&#30053;&#22270;" width="260"/>
                <button name="action_download_waybill_images" type="object" string="&#19979;&#36733;&#22270;&#29255;" class="btn-link"/>
                <button name="action_open_waybill_evidences" type="object" string="&#35777;&#25454;&#26126;&#32454;" class="btn-link"/>
                <button name="action_open_waybill_record" type="object" string="&#36816;&#21333;&#35814;&#24773;" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_summary_form" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.summary.form</field>
        <field name="model">logistics.trace.evidence.summary</field>
        <field name="arch" type="xml">
            <form string="&#30041;&#30165;&#35777;&#25454;&#27719;&#24635;" create="0" edit="0" delete="0">
                <header>
                    <button name="action_download_waybill_images" type="object" string="&#19979;&#36733;&#22270;&#29255;" class="btn-primary"/>
                    <button name="action_open_waybill_evidences" type="object" string="&#26597;&#30475;&#35777;&#25454;&#26126;&#32454;" class="btn-secondary"/>
                    <button name="action_open_waybill_record" type="object" string="&#25171;&#24320;&#36816;&#21333;" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="waybill_no" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="waybill_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                            <field name="upload_role" readonly="1"/>
                        </group>
                        <group>
                            <field name="trace_event_count" readonly="1"/>
                            <field name="evidence_count" readonly="1"/>
                            <field name="latest_uploaded_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="&#35777;&#25454;&#22270;&#24211;">
                        <field name="gallery_html" widget="html" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_summary_search" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.summary.search</field>
        <field name="model">logistics.trace.evidence.summary</field>
        <field name="arch" type="xml">
            <search string="&#30041;&#30165;&#35777;&#25454;&#27719;&#24635;">
                <field name="waybill_no"/>
                <field name="batch_id"/>
                <field name="upload_role"/>
                <filter string="&#20179;&#24211;&#30041;&#30165;" name="warehouse_trace" domain="[('upload_role', '=', 'warehouse')]"/>
                <filter string="&#21496;&#26426;&#30041;&#30165;" name="driver_trace" domain="[('upload_role', '=', 'driver')]"/>
                <filter string="&#26410;&#26631;&#35760;" name="unknown_trace" domain="[('upload_role', '=', 'unknown')]"/>
                <group>
                    <filter string="&#25353;&#25209;&#27425;" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="&#25353;&#30041;&#30165;&#31471;" name="group_upload_role" context="{'group_by': 'upload_role'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_tree" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.tree</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <list string="Trace Evidence">
                <field name="uploaded_at"/>
                <field name="name"/>
                <field name="batch_id"/>
                <field name="upload_role" string="留痕端"/>
                <field name="trace_event_type" optional="show"/>
                <field name="trace_event_time" optional="show"/>
                <field name="trace_event_display_name" optional="hide"/>
                <field name="trace_event_id" optional="hide"/>
                <field name="waybill_id"/>
                <field name="uploader_id"/>
                <field name="image_count"/>
                <field name="preview_url" optional="hide"/>
                <field name="image_items_json" widget="logistics_evidence_thumbnails" string="证据缩略图"/>
                <field name="is_exception_related"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_form" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.form</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <form string="Trace Evidence">
                <header>
                    <button name="action_download_images" type="object" string="下载图片" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="trace_event_id"/>
                            <field name="trace_event_type" readonly="1"/>
                            <field name="trace_event_time" readonly="1"/>
                            <field name="waybill_id" readonly="1"/>
                            <field name="batch_id" readonly="1"/>
                            <field name="uploaded_at"/>
                        </group>
                        <group>
                            <field name="uploader_id"/>
                            <field name="uploader_name" readonly="1"/>
                            <field name="upload_role"/>
                            <field name="sequence"/>
                            <field name="state"/>
                            <field name="image_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Cover Image Compatibility" invisible="1">
                            <field name="image_access_key"/>
                            <field name="preview_url"/>
                            <field name="full_url"/>
                        </group>
                        <group string="Evidence Context">
                            <field name="is_exception_related" readonly="1"/>
                            <field name="remark"/>
                        </group>
                    </group>
                    <group string="Images" col="1">
                        <field name="image_items_json" widget="logistics_evidence_record_viewer" nolabel="1" readonly="1"/>
                        <field name="image_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_event_form_evidence_back" model="ir.ui.view">
        <field name="name">logistics.trace.event.form.evidence.back</field>
        <field name="model">logistics.trace.event</field>
        <field name="inherit_id" ref="logistics_trace_core.view_logistics_trace_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_logistics_trace_evidence_search" model="ir.ui.view">
        <field name="name">logistics.trace.evidence.search</field>
        <field name="model">logistics.trace.evidence</field>
        <field name="arch" type="xml">
            <search string="Trace Evidence">
                <field name="name"/>
                <field name="trace_event_type"/>
                <field name="trace_event_id"/>
                <field name="waybill_id"/>
                <field name="upload_role"/>
                <field name="image_access_key"/>
                <separator/>
                <filter string="仓库证据" name="warehouse_trace" domain="[('upload_role', '=', 'warehouse')]"/>
                <filter string="司机证据" name="driver_trace" domain="[('upload_role', '=', 'driver')]"/>
                <filter string="未标记" name="unknown_trace" domain="[('upload_role', '=', 'unknown')]"/>
                <separator/>
                <filter string="完成签收" name="event_signoff" domain="[('trace_event_type', '=', 'signoff')]"/>
                <filter string="完成装车" name="event_finish_loading" domain="[('trace_event_type', '=', 'finish_loading')]"/>
                <filter string="到达门店" name="event_arrive_store" domain="[('trace_event_type', '=', 'arrive_store')]"/>
                <filter string="离开门店" name="event_departed" domain="[('trace_event_type', '=', 'departed')]"/>
                <filter string="异常上报" name="event_exception" domain="[('trace_event_type', '=', 'exception_report')]"/>
                <separator/>
                <filter string="Exception Related" name="exception_related" domain="[('is_exception_related', '=', True)]"/>
                <group>
                    <filter string="By Waybill" name="group_waybill" context="{'group_by': 'waybill_id'}"/>
                    <filter string="By Trace Event" name="group_trace" context="{'group_by': 'trace_event_id'}"/>
                    <filter string="按留痕端" name="group_upload_role" context="{'group_by': 'upload_role'}"/>
                    <filter string="By Uploader" name="group_uploader" context="{'group_by': 'uploader_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_trace_evidence_summary" model="ir.actions.act_window">
        <field name="name">&#30041;&#30165;&#35777;&#25454;&#27719;&#24635;</field>
        <field name="res_model">logistics.trace.evidence.summary</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_summary_search"/>
    </record>

    <record id="action_logistics_trace_evidence_summary_warehouse" model="ir.actions.act_window">
        <field name="name">&#20179;&#24211;&#30041;&#30165;</field>
        <field name="res_model">logistics.trace.evidence.summary</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('upload_role', 'in', ['warehouse', 'unknown'])]</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_summary_search"/>
    </record>

    <record id="action_logistics_trace_evidence_summary_driver" model="ir.actions.act_window">
        <field name="name">&#21496;&#26426;&#30041;&#30165;</field>
        <field name="res_model">logistics.trace.evidence.summary</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('upload_role', 'in', ['driver', 'unknown'])]</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_summary_search"/>
    </record>

    <record id="action_logistics_trace_evidence" model="ir.actions.act_window">
        <field name="name">Evidence</field>
        <field name="res_model">logistics.trace.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_search"/>
    </record>

    <record id="action_logistics_trace_evidence_warehouse" model="ir.actions.act_window">
        <field name="name">仓库证据</field>
        <field name="res_model">logistics.trace.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('upload_role', 'in', ['warehouse', 'unknown'])]</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_search"/>
    </record>

    <record id="action_logistics_trace_evidence_driver" model="ir.actions.act_window">
        <field name="name">司机证据</field>
        <field name="res_model">logistics.trace.evidence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('upload_role', 'in', ['driver', 'unknown'])]</field>
        <field name="search_view_id" ref="view_logistics_trace_evidence_search"/>
    </record>

    <menuitem
        id="menu_logistics_trace_evidence"
        name="Evidence"
        parent="logistics_dispatch.menu_logistics_dispatch"
        action="action_logistics_trace_evidence_summary"
        sequence="50"/>

    <menuitem
        id="menu_logistics_trace_evidence_warehouse"
        name="仓库证据"
        parent="menu_logistics_trace_evidence"
        action="action_logistics_trace_evidence_summary_warehouse"
        sequence="10"/>

    <menuitem
        id="menu_logistics_trace_evidence_driver"
        name="司机证据"
        parent="menu_logistics_trace_evidence"
        action="action_logistics_trace_evidence_summary_driver"
        sequence="20"/>
</odoo>
