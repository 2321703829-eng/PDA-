<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pda_user" model="res.groups">
        <field name="name">PDA Warehouse User</field>
        <field name="implied_ids" eval="[(4, ref('erp_base.group_wms_operator'))]"/>
    </record>

    <record id="group_pda_leader" model="res.groups">
        <field name="name">PDA Warehouse Leader</field>
        <field name="implied_ids" eval="[(4, ref('wms_pda_api.group_pda_user')), (4, ref('erp_base.group_wms_manager'))]"/>
    </record>

    <record id="group_pda_admin" model="res.groups">
        <field name="name">PDA Warehouse Admin</field>
        <field name="implied_ids" eval="[(4, ref('wms_pda_api.group_pda_leader'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>
</odoo>
