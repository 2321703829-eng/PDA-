<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_after_sale_list" model="ir.ui.view">
        <field name="name">b2b.after.sale.list</field><field name="model">b2b.after.sale.ticket</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="order_id"/><field name="partner_id"/><field name="ticket_type"/><field name="state"/></list></field>
    </record>
    <record id="view_after_sale_form" model="ir.ui.view">
        <field name="name">b2b.after.sale.form</field><field name="model">b2b.after.sale.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header><field name="state" widget="statusbar"/></header>
                <sheet>
                    <group><field name="name"/><field name="order_id"/><field name="partner_id"/><field name="ticket_type"/></group>
                    <group><field name="description"/></group>
                    <field name="image_ids" widget="many2many_binary"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_after_sale" model="ir.actions.act_window">
        <field name="name">B2B 售后申请</field><field name="res_model">b2b.after.sale.ticket</field><field name="view_mode">list,form</field>
    </record>
</odoo>
