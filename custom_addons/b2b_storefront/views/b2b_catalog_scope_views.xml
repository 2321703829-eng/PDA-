<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_catalog_scope_list" model="ir.ui.view">
        <field name="name">b2b.catalog.scope.list</field><field name="model">b2b.catalog.scope</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="scope_type"/><field name="is_active"/></list></field>
    </record>
    <record id="view_catalog_scope_form" model="ir.ui.view">
        <field name="name">b2b.catalog.scope.form</field><field name="model">b2b.catalog.scope</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group><field name="name"/><field name="partner_id"/><field name="scope_type"/><field name="is_active"/></group>
                    <group><field name="product_ids" widget="many2many_tags"/><field name="product_category_ids" widget="many2many_tags"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_catalog_scope" model="ir.actions.act_window">
        <field name="name">B2B 可见范围</field><field name="res_model">b2b.catalog.scope</field><field name="view_mode">list,form</field>
    </record>
</odoo>
