<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_dispatch_wave_tree" model="ir.ui.view">
        <field name="name">logistics.dispatch.wave.tree</field>
        <field name="model">logistics.dispatch.wave</field>
        <field name="arch" type="xml">
            <list string="波次列表">
                <field name="name"/>
                <field name="dispatch_date"/>
                <field name="warehouse_id"/>
                <field name="state"/>
                <field name="total_batch_count"/>
                <field name="total_waybill_count"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_dispatch_wave_form" model="ir.ui.view">
        <field name="name">logistics.dispatch.wave.form</field>
        <field name="model">logistics.dispatch.wave</field>
        <field name="arch" type="xml">
            <form string="波次">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="dispatch_date"/>
                            <field name="warehouse_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="planned_depart_time"/>
                            <field name="total_batch_count" readonly="1"/>
                            <field name="total_waybill_count" readonly="1"/>
                            <field name="total_order_count" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="remark" placeholder="填写本波次的协同说明或调度备注"/>
                    </group>
                    <notebook>
                        <page string="批次">
                            <field name="batch_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="warehouse_id"/>
                                    <field name="vehicle_id"/>
                                    <field name="driver_employee_id"/>
                                    <field name="state"/>
                                    <field name="total_waybill_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_dispatch_wave_search" model="ir.ui.view">
        <field name="name">logistics.dispatch.wave.search</field>
        <field name="model">logistics.dispatch.wave</field>
        <field name="arch" type="xml">
            <search string="波次查询">
                <field name="name"/>
                <field name="warehouse_id"/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="执行中" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <group>
                    <filter string="按仓库" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="按状态" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_dispatch_wave" model="ir.actions.act_window">
        <field name="name">波次</field>
        <field name="res_model">logistics.dispatch.wave</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_dispatch_wave_search"/>
    </record>
</odoo>
