<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_logistics_dispatch_manager" model="res.groups">
        <field name="name">调度主链管理</field>
        <field name="comment">允许维护波次、批次和运单主链对象，并作为执行态状态修改入口。</field>
        <field name="sequence">228</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_import_manager" model="res.groups">
        <field name="name">标准导入管理</field>
        <field name="comment">允许查看全部标准导入任务、源文件和错误结果。</field>
        <field name="sequence">229</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_export_user" model="res.groups">
        <field name="name">标准导出执行</field>
        <field name="comment">允许发起标准主链导出，并查看本人导出任务结果。</field>
        <field name="sequence">230</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_export_manager" model="res.groups">
        <field name="name">标准导出管理</field>
        <field name="comment">允许查看全部标准导出任务，并保留后续管理动作入口。</field>
        <field name="sequence">231</field>
        <field name="implied_ids" eval="[(4, ref('group_logistics_export_user'))]"/>
    </record>

    <record id="group_logistics_dispatch_manager" model="res.groups"><field name="user_ids" eval="[(4, ref('base.user_admin'))]"/></record>
