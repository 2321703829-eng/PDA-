<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== 全局 CSS: 隐藏不需要的元素 ===== -->
    <template id="kebi_custom_css" inherit_id="website.layout" name="Kebi Custom CSS">
        <xpath expr="//head" position="inside">
            <style>
                /* ── 登录页: 完全移除Odoo默认header/footer,只保留蓝色登录界面 ── */
                body.kebi-login-body > header,
                body.kebi-login-body > nav,
                body.kebi-login-body #wrapwrap > header,
                body.kebi-login-body #wrapwrap > nav,
                body.kebi-login-body .o_main_navbar,
                body.kebi-login-body #o_header,
                body.kebi-login-body header#top { display: none !important; }
                body.kebi-login-body footer,
                body.kebi-login-body #footer,
                body.kebi-login-body .o_footer_copyright { display: none !important; }
                /* 移除Odoo默认的白色背景容器 */
                body.kebi-login-body { background: transparent !important; }
                body.kebi-login-body #wrapwrap { background: transparent !important; }
                /* 隐藏搜索按钮 */
                .o_search_button, .search-query, [data-bs-toggle=\"search\"],
                #search, .header-search, .te_header_search { display: none !important; }
                /* 隐藏购物车 */
                .o_wsale_my_cart, #my_cart, .my_cart, .o_my_cart,
                .header-cart, [href=\"/shop/cart\"] { display: none !important; }
                /* 隐藏 Footer 社交图标区 */
                footer .fa-facebook, footer .fa-twitter, footer .fa-instagram,
                footer .fa-linkedin, footer .fa-youtube, footer .fa-github,
                footer a[href*=\"facebook\"], footer a[href*=\"twitter\"],
                footer a[href*=\"instagram\"], footer a[href*=\"linkedin\"],
                footer a[href*=\"youtube\"], footer a[href*=\"github\"] { display: none !important; }
                /* 隐藏语言选择器旁边多余的社交文本 */
                footer .js_language_selector + div { display: none !important; }
            </style>
        </xpath>
    </template>

    <!-- ===== 登录页全面重设计(UI Pro Max B2B风格) ===== -->
    <template id="kebi_login_redesign" inherit_id="auth_signup.login" name="Kebi Login Redesign">
        <xpath expr="//head" position="inside">
            <style>
                /* ── 重置Odoo登录页为B2B专业风格 ── */
                .kebi-login-page {
                    min-height: 100vh; display: flex; align-items: center; justify-content: center;
                    background: linear-gradient(135deg, #0f1f3d 0%, #1a3a5c 40%, #1e4d7b 70%, #1a56db 100%);
                    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
                    padding: 20px;
                }
                .kebi-login-card {
                    display: flex; max-width: 960px; width: 100%; background: #fff;
                    border-radius: 16px; overflow: hidden;
                    box-shadow: 0 24px 80px rgba(0,0,0,.25), 0 8px 24px rgba(0,0,0,.15);
                }
                .kebi-brand-side {
                    flex: 1; background: linear-gradient(160deg, #0d1b33 0%, #132744 50%, #0f2744 100%);
                    padding: 60px 48px; display: flex; flex-direction: column; justify-content: center;
                    color: #fff; position: relative; overflow: hidden;
                }
                .kebi-brand-side::before {
                    content: ''; position: absolute; top: -100px; right: -100px;
                    width: 300px; height: 300px; border-radius: 50%;
                    background: rgba(26,86,219,.15); pointer-events: none;
                }
                .kebi-brand-side::after {
                    content: ''; position: absolute; bottom: -60px; left: -60px;
                    width: 200px; height: 200px; border-radius: 50%;
                    background: rgba(26,86,219,.1); pointer-events: none;
                }
                .kebi-brand-side > * { position: relative; z-index: 1; }
                .kebi-brand-logo { font-size: 40px; font-weight: 800; letter-spacing: 2px; margin-bottom: 12px; }
                .kebi-brand-tagline { font-size: 15px; color: rgba(255,255,255,.7); margin-bottom: 40px; line-height: 1.6; }
                .kebi-brand-features { list-style: none; padding: 0; margin: 0 0 48px 0; }
                .kebi-brand-features li { padding: 10px 0; font-size: 14px; color: rgba(255,255,255,.8);
                    display: flex; align-items: center; gap: 10px; }
                .kebi-brand-features li::before { content: '◆'; color: #3b82f6; font-size: 8px; }
                .kebi-brand-contact { font-size: 13px; color: rgba(255,255,255,.5); line-height: 1.8; }
                .kebi-form-side {
                    flex: 1; padding: 60px 48px; display: flex; flex-direction: column; justify-content: center;
                }
                .kebi-form-side h2 { font-size: 24px; font-weight: 700; color: #111827; margin-bottom: 6px; }
                .kebi-form-side .subtitle { font-size: 14px; color: #6b7280; margin-bottom: 32px; }
                .kebi-form-side .form-control {
                    height: 48px; border: 1.5px solid #e5e7eb; border-radius: 10px;
                    padding: 0 16px; font-size: 15px; transition: border-color .2s, box-shadow .2s;
                }
                .kebi-form-side .form-control:focus {
                    border-color: #1a56db; box-shadow: 0 0 0 4px rgba(26,86,219,.12); outline: none;
                }
                .kebi-form-side .btn-primary {
                    height: 50px; border-radius: 10px; font-size: 16px; font-weight: 600;
                    background: linear-gradient(135deg, #1a56db 0%, #1e40af 100%);
                    border: none; width: 100%; transition: transform .15s, box-shadow .15s;
                }
                .kebi-form-side .btn-primary:hover {
                    transform: translateY(-1px); box-shadow: 0 8px 24px rgba(26,86,219,.35);
                }
                .kebi-form-side .form-label { font-size: 14px; font-weight: 600; color: #374151; margin-bottom: 6px; }
                .kebi-form-side .form-group { margin-bottom: 20px; }
                .kebi-form-side .forgot-link { font-size: 13px; color: #6b7280; text-decoration: none; }
                .kebi-form-side .forgot-link:hover { color: #1a56db; }
                .kebi-lang-selector { position: absolute; top: 20px; right: 20px; font-size: 12px; }
                @media (max-width: 768px) {
                    .kebi-login-card { flex-direction: column; max-width: 420px; }
                    .kebi-brand-side { padding: 40px 32px; }
                    .kebi-form-side { padding: 40px 32px; }
                }
            </style>
        </xpath>
        <xpath expr="//div[contains(@class,'oe_login_form') or contains(@class,'container')]" position="replace">
            <script>document.body.classList.add('kebi-login-body');</script>
            <t t-set="dbname" t-value="dbname if 'dbname' in dir() else request.env.cr.dbname"/>
            <div class="kebi-login-page">
                <div class="kebi-lang-selector">
                    <t t-call="portal.language_select"/>
                </div>
                <div class="kebi-login-card">
                    <!-- 左侧品牌区 -->
                    <div class="kebi-brand-side">
                        <div class="kebi-brand-logo">天枢科技</div>
                        <div class="kebi-brand-tagline">城市供应链全链路数字化解决方案</div>
                        <ul class="kebi-brand-features">
                            <li>ERP 经营管理系统</li>
                            <li>WMS 仓储管理系统</li>
                            <li>TMS 运输管理系统</li>
                            <li>BI 数据控制塔</li>
                            <li>B2B 订货商城</li>
                        </ul>
                        <div class="kebi-brand-contact">
                            📞 18438369520<br/>
                            📧 2542127368@qq.com<br/>
                            <a href="/my/profile" style="color:rgba(255,255,255,.7);font-size:13px;text-decoration:none;
                               display:inline-block;margin-top:8px;padding:4px 12px;border:1px solid rgba(255,255,255,.3);
                               border-radius:6px">👤 个人中心</a>
                            <br/><span style="font-size:11px;color:rgba(255,255,255,.3)">© 2026 天枢科技</span>
                        </div>
                    </div>
                    <!-- 右侧登录表单 -->
                    <div class="kebi-form-side">
                        <h2>欢迎回来</h2>
                        <p class="subtitle">请使用您的账号登录系统</p>
                        <t t-if="error">
                            <div class="alert alert-danger" style="font-size:14px"><t t-esc="error"/></div>
                        </t>
                        <form method="post" t-att-action="action or '/web/login'" role="form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="redirect" t-att-value="redirect or ''"/>
                            <div class="form-group">
                                <label class="form-label" for="login">账号</label>
                                <input type="text" name="login" id="login" class="form-control"
                                    t-att-value="login" autofocus="autofocus" placeholder="请输入账号" required="required"/>
                            </div>
                            <div class="form-group">
                                <label class="form-label" for="password">密码</label>
                                <input type="password" name="password" id="password" class="form-control"
                                    placeholder="请输入密码" required="required"/>
                            </div>
                            <div class="form-group" t-if="dblist and databases">
                                <label class="form-label" for="db">数据库</label>
                                <select name="db" id="db" class="form-control">
                                    <option value="">选择数据库</option>
                                    <t t-foreach="databases" t-as="db">
                                        <option t-att-value="db" t-att-selected="db == dbname and 'selected' or None">
                                            <t t-esc="db"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary">登 录</button>
                            <div style="text-align:right;margin-top:12px">
                                <t t-set="reset_url" t-value="'/web/reset_password?db=%s' % request.env.cr.dbname"/>
                                <a t-att-href="reset_url" class="forgot-link">忘记密码?</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <!-- ===== Footer: 删除社交 ===== -->
    <template id="footer_clean" inherit_id="website.footer_custom" name="Kebi Footer Clean">
        <xpath expr="//div[contains(@class,'o_footer_copyright')]/.." position="replace"/>
        <xpath expr="//div[@class='o_footer_copyright']/.." position="replace"/>
    </template>

    <!-- ===== Footer: 语言选择器简化 + 社交链接删除 ===== -->
    <template id="footer_lang_clean" inherit_id="website.layout" name="Kebi Footer Lang" primary="False">
        <xpath expr="//footer//div[contains(@class,'js_language_selector')]" position="after">
            <div style="text-align:center;padding:15px 0;color:#999;font-size:13px">
                © 天枢科技 | 联系电话: 18438369520 | 联系邮箱: 2542127368@qq.com
            </div>
        </xpath>
    </template>

    <!-- ===== 个人中心 ===== -->
    <template id="profile_template" name="Kebi Profile">
        <t t-call="website.layout">
            <div id="wrap"><div class="container" style="max-width:720px;margin-top:30px">
                <h3>个人中心</h3>
                <t t-if="msg == 'saved'"><div class="alert alert-success">保存成功</div></t>
                <div class="card" style="margin-top:16px">
                    <div class="card-body">
                        <form method="post" action="/my/profile/save">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <div class="form-group"><label class="font-weight-bold">联系人</label><input class="form-control" t-att-value="partner.name" readonly="readonly" style="background:#f9fafb"/></div>
                            <div class="form-group"><label>联系电话</label><input type="text" name="phone" class="form-control" t-att-value="phone" placeholder="请输入联系电话"/></div>
                            <div class="form-group"><label>联系邮箱</label><input type="email" name="email" class="form-control" t-att-value="email" placeholder="请输入邮箱"/></div>
                            <div class="form-group"><label>默认收货门店</label>
                                <select name="default_store_id" class="form-control">
                                    <option value="">请选择</option>
                                    <t t-foreach="stores" t-as="s"><option t-att-value="s.id" t-att-selected="'selected' if str(default_store_id) == str(s.id) else None"><t t-esc="s.name"/></option></t>
                                </select>
                            </div>
                            <div class="form-group"><label>常用配送备注</label><textarea name="delivery_note" class="form-control" rows="2" placeholder="如: 工作日收货、需提前联系、放前台"><t t-esc="delivery_note or ''"/></textarea></div>
                            <button type="submit" class="btn btn-primary">保存设置</button>
                        </form>
                    </div>
                </div>
            </div></div>
        </t>
    </template>

    <!-- ===== 关于我们页 ===== -->
    <template id="aboutus_custom" inherit_id="website.aboutus" name="Kebi About Us">
        <xpath expr="//section[1]" position="after">
            <section class="container mt-5 mb-5">
                <h2 class="text-center mb-4">关于天枢科技</h2>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <p class="lead text-center" style="font-size:1.1rem;line-height:2">
                        天枢科技是一家专注于城市供应链全链路数字化解决方案的科技企业。
                        我们通过 ERP、WMS、TMS、BI 等系统模块，帮助客户实现从订单、
                        仓储、配送到结算的全流程智能化管理，致力于让每一件货物的流转都
                        更加高效、透明、可追溯。
                        </p>
                        <div class="text-center mt-4">
                            <p>📞 联系电话：18438369520</p>
                            <p>📧 联系邮箱：2542127368@qq.com</p>
                        </div>
                    </div>
                </div>
            </section>
        </xpath>
    </template>

</odoo>
