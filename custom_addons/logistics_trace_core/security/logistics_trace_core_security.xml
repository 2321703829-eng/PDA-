<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_logistics_readonly_viewer" model="res.groups">
        <field name="name">Logistics Readonly Viewer</field>
        <field name="comment">Can read logistics trace, evidence, and exception information inside the current tenant database.</field>
        <field name="sequence">226</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_dispatch_operator" model="res.groups">
        <field name="name">Logistics Dispatch Operator</field>
        <field name="comment">Can submit day-to-day trace and exception records for waybill operations.</field>
        <field name="sequence">227</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_image_field_operator" model="res.groups">
        <field name="name">Logistics Image Field Operator</field>
        <field name="comment">Can upload on-site images and submit trace records with basic read access.</field>
        <field name="sequence">228</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_trace_event_manager" model="res.groups">
        <field name="name">Logistics Trace Event Manager</field>
        <field name="comment">Can review and maintain all logistics trace events.</field>
        <field name="sequence">229</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_logistics_readonly_viewer" model="res.groups"><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
    <record id="group_logistics_dispatch_operator" model="res.groups"><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
    <record id="group_logistics_image_field_operator" model="res.groups"><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
    <record id="group_logistics_trace_event_manager" model="res.groups"><field name="users" eval="[(4, ref('base.user_admin'))]"/></record>
</odoo>
