<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="dashboard_template" name="TMS Dashboard">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="container-fluid" style="padding:24px 32px">
                    <h3 style="margin-bottom:4px;font-weight:700;color:#111827">配送调度工作台</h3>
                    <p style="color:#6b7280;margin-bottom:24px">物流配送全流程管理中心</p>
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px">
                        <t t-foreach="cards" t-as="card">
                            <a t-att-href="'/web#action=' + card['action'].split(',')[1] + '&amp;model=' + card['model'] + '&amp;view_type=list'"
                               style="display:block;background:#fff;border:1px solid #e5e7eb;border-radius:12px;
                                      padding:24px 20px;text-decoration:none;transition:box-shadow .15s,border-color .15s;
                                      cursor:pointer"
                               onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,.1)';this.style.borderColor='#1a56db'"
                               onmouseout="this.style.boxShadow='none';this.style.borderColor='#e5e7eb'">
                                <div style="width:44px;height:44px;border-radius:12px;background:#eff6ff;display:flex;
                                            align-items:center;justify-content:center;margin-bottom:12px">
                                    <i t-att-class="'fa ' + card['icon']" style="font-size:20px;color:#1a56db"/>
                                </div>
                                <div style="font-size:15px;font-weight:600;color:#111827;margin-bottom:4px">
                                    <t t-esc="card['name']"/>
                                </div>
                                <div style="font-size:13px;color:#9ca3af">
                                    <t t-esc="card['desc']"/>
                                </div>
                            </a>
                        </t>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
