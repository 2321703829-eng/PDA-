<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_route_planning_batch_form_full" model="ir.ui.view">
        <field name="name">logistics.route.planning.batch.form.full</field>
        <field name="model">logistics.route.planning.batch</field>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_route_map" type="object" string="路线地图" class="btn-primary"/>
                    <field name="route_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_dispatch_orders" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="dispatch_order_count" string="派车单" widget="statinfo"/>
                        </button>
                        <button name="action_open_driver_tasks" type="object" class="oe_stat_button" icon="fa-user">
                            <field name="driver_task_count" string="司机任务" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="batch_no"/>
                            <field name="delivery_date"/>
                            <field name="route_status"/>
                            <field name="planning_state"/>
                            <field name="entry_mode"/>
                        </group>
                        <group>
                            <field name="vehicle_no"/>
                            <field name="driver_name"/>
                            <field name="driver_phone"/>
                            <field name="warehouse_id"/>
                        </group>
                    </group>
                    <group string="线路站点">
                        <field name="stop_line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="stop_seq"/>
                                <field name="store_name"/>
                                <field name="waybill_no"/>
                                <field name="address_detail"/>
                                <field name="vehicle_no"/>
                                <field name="driver_name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
