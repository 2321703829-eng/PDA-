<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_station_table_form" model="ir.ui.view">
        <field name="name">tms.create.station.table.form</field>
        <field name="model">tms.create.station.table</field>
        <field name="arch" type="xml">
            <form string="生成排线站点表">
                <group>
                    <group string="上传文件">
                        <field name="sales_file" filename="sales_file_name"/>
                        <field name="sales_file_name" invisible="1"/>
                        <field name="store_file" filename="store_file_name"/>
                        <field name="store_file_name" invisible="1"/>
                    </group>
                    <group string="输出">
                        <field name="output_name"/>
                        <field name="state" widget="statusbar"/>
                        <field name="station_count" invisible="state != 'done'"/>
                        <field name="result_batch_id" invisible="state != 'done'"/>
                    </group>
                </group>
                <group string="处理日志" invisible="state == 'draft'">
                    <field name="log" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_process" type="object" string="开始处理" class="btn-primary" invisible="state != 'draft'"/>
                    <button string="关闭" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_station_table" model="ir.actions.act_window">
        <field name="name">生成排线站点表</field>
        <field name="res_model">tms.create.station.table</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_logistics_route_planning_batch"/>
    </record>
</odoo>
