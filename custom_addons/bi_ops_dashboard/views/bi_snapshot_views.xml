<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bi_ops_dashboard_board_form" model="ir.ui.view">
        <field name="name">bi.ops.dashboard.board.form</field>
        <field name="model">bi.ops.dashboard.board</field>
        <field name="arch" type="xml">
            <form create="false" delete="false" edit="false">
                <header>
                    <button name="action_refresh_board" type="object" string="Refresh Today"/>
                    <button name="action_open_kpi_report" type="object" string="KPI Daily Report"/>
                    <button name="action_open_exception_ledger" type="object" string="Exception Ledger"/>
                </header>
                <sheet>
                    <group>
                        <field name="snapshot_date"/>
                    </group>
                    <group string="Operations Overview" col="4">
                        <field name="order_count"/>
                        <field name="warehouse_task_count"/>
                        <field name="dispatch_count"/>
                        <field name="exception_count"/>
                    </group>
                    <group string="Warehouse &amp; Dispatch" col="4">
                        <field name="receipt_count"/>
                        <field name="outbound_count"/>
                        <field name="handover_count"/>
                        <field name="driver_task_count"/>
                    </group>
                    <group string="Delivery Result" col="4">
                        <field name="signoff_count"/>
                        <field name="signed_count"/>
                        <field name="in_transit_count"/>
                    </group>
                    <group string="Cost Snapshot" col="4">
                        <field name="revenue_amount"/>
                        <field name="cost_amount"/>
                        <field name="freight_amount"/>
                        <field name="gross_profit_amount"/>
                    </group>
                    <group string="Drilldown Entry" col="3">
                        <button name="action_open_order_dashboard" type="object" string="Open Order Dashboard"/>
                        <button name="action_open_warehouse_dashboard" type="object" string="Open Warehouse Dashboard"/>
                        <button name="action_open_dispatch_dashboard" type="object" string="Open Dispatch Dashboard"/>
                        <button name="action_open_cost_dashboard" type="object" string="Open Cost Dashboard"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bi_daily_kpi_snapshot_tree" model="ir.ui.view">
        <field name="name">bi.daily.kpi.snapshot.tree</field>
        <field name="model">bi.daily.kpi.snapshot</field>
        <field name="arch" type="xml">
            <list>
                <field name="snapshot_date"/>
                <field name="order_count"/>
                <field name="warehouse_task_count"/>
                <field name="dispatch_count"/>
                <field name="signoff_count"/>
                <field name="exception_count"/>
            </list>
        </field>
    </record>

    <record id="view_bi_daily_kpi_snapshot_form" model="ir.ui.view">
        <field name="name">bi.daily.kpi.snapshot.form</field>
        <field name="model">bi.daily.kpi.snapshot</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_today_snapshot" type="object" string="Generate Today"/>
                    <button name="action_generate_all_today_snapshots" type="object" string="Generate All"/>
                    <button name="action_open_order_details" type="object" string="Open Orders"/>
                    <button name="action_open_exception_details" type="object" string="Open Exceptions"/>
                </header>
                <sheet>
                    <notebook>
                        <page string="Summary">
                            <group>
                                <field name="snapshot_date"/>
                                <field name="order_count"/>
                                <field name="warehouse_task_count"/>
                                <field name="dispatch_count"/>
                                <field name="signoff_count"/>
                                <field name="exception_count"/>
                            </group>
                            <group string="Drilldown">
                                <button name="action_open_warehouse_snapshot" type="object" string="Open Warehouse Dashboard"/>
                                <button name="action_open_dispatch_snapshot" type="object" string="Open Dispatch Dashboard"/>
                                <button name="action_open_cost_snapshot" type="object" string="Open Cost Dashboard"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

