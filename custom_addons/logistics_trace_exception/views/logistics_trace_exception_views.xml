<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_logistics_trace_exception_tree" model="ir.ui.view">
        <field name="name">logistics.trace.exception.tree</field>
        <field name="model">logistics.trace.exception</field>
        <field name="arch" type="xml">
            <list string="Exceptions" default_order="is_overdue desc, severity_level desc, report_time desc, id desc" decoration-danger="severity_level == 'critical' or is_overdue" decoration-warning="severity_level == 'high'" decoration-info="state == 'processing'">
                <field name="name"/>
                <field name="exception_type"/>
                <field name="severity_level"/>
                <field name="state"/>
                <field name="waybill_id"/>
                <field name="batch_id"/>
                <field name="trace_event_id"/>
                <field name="evidence_count"/>
                <field name="process_owner_name"/>
                <field name="report_time"/>
                <field name="is_overdue"/>
            </list>
        </field>
    </record>

    <record id="view_logistics_trace_exception_form" model="ir.ui.view">
        <field name="name">logistics.trace.exception.form</field>
        <field name="model">logistics.trace.exception</field>
        <field name="arch" type="xml">
            <form string="Exception Detail">
                <header>
                    <button name="action_mark_processing" type="object" string="Start Processing" class="btn-primary" groups="logistics_trace_evidence.group_logistics_trace_manager" invisible="state != 'open'"/>
                    <button name="action_mark_resolved" type="object" string="Mark Resolved" class="btn-secondary" groups="logistics_trace_evidence.group_logistics_trace_manager" invisible="state not in ('open', 'processing')"/>
                    <button name="action_mark_closed" type="object" string="Close Exception" class="btn-secondary" groups="logistics_trace_evidence.group_logistics_trace_manager" invisible="state not in ('resolved', 'processing')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,processing,resolved,closed,cancelled"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button name="action_open_waybill" type="object" class="oe_stat_button" icon="fa-truck" invisible="not waybill_id">
                            <span class="o_stat_text">Open Waybill</span>
                        </button>
                        <button name="action_open_trace_event" type="object" class="oe_stat_button" icon="fa-stream" invisible="not trace_event_id">
                            <span class="o_stat_text">Open Trace</span>
                        </button>
                        <button name="action_open_batch" type="object" class="oe_stat_button" icon="fa-layer-group" invisible="not batch_id">
                            <span class="o_stat_text">Open Batch</span>
                        </button>
                        <button name="action_open_evidence" type="object" class="oe_stat_button" icon="fa-image" invisible="not trace_event_id">
                            <field name="evidence_count" string="Open Evidence" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="exception_type"/>
                            <field name="severity_level"/>
                            <field name="report_time"/>
                            <field name="reporter_user_id"/>
                        </group>
                        <group>
                            <field name="process_owner_id"/>
                            <field name="is_overdue" readonly="1"/>
                            <field name="closed_time" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Related Context">
                            <field name="waybill_id"/>
                            <field name="batch_id"/>
                            <field name="trace_event_id"/>
                        </group>
                        <group string="Summary">
                            <field name="reporter_user_name" readonly="1"/>
                            <field name="process_owner_name" readonly="1"/>
                            <field name="evidence_count" readonly="1"/>
                            <field name="remark"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe the issue, impact, and current business problem."/>
                    </group>
                    <group string="Close Summary">
                        <field name="close_summary" placeholder="Provide the final handling result before closing or cancelling."/>
                    </group>
                    <notebook>
                        <page string="Process Logs">
                            <field name="process_log_ids" readonly="1">
                                <list>
                                    <field name="action_time"/>
                                    <field name="action_type"/>
                                    <field name="operator_name"/>
                                    <field name="from_state"/>
                                    <field name="to_state"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="message_follower_ids" invisible="1"/>
                    <field name="activity_ids" invisible="1"/>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="activity_ids" widget="mail_activity"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_logistics_trace_exception_search" model="ir.ui.view">
        <field name="name">logistics.trace.exception.search</field>
        <field name="model">logistics.trace.exception</field>
        <field name="arch" type="xml">
            <search string="Exceptions">
                <field name="name"/>
                <field name="exception_type"/>
                <field name="severity_level"/>
                <field name="state"/>
                <field name="waybill_id"/>
                <field name="batch_id"/>
                <field name="trace_event_id"/>
                <field name="process_owner_id"/>
                <filter string="Open" name="open" domain="[('state', '=', 'open')]"/>
                <filter string="Active" name="active" domain="[('state', 'in', ('open', 'processing'))]"/>
                <filter string="Processing" name="processing" domain="[('state', '=', 'processing')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue', '=', True)]"/>
                <filter string="High Severity" name="high_severity" domain="[('severity_level', 'in', ('high', 'critical'))]"/>
                <filter string="Evidence Missing" name="evidence_missing" domain="[('exception_type', '=', 'evidence_missing')]"/>
                <group>
                    <filter string="By State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="By Severity" name="group_severity" context="{'group_by': 'severity_level'}"/>
                    <filter string="By Waybill" name="group_waybill" context="{'group_by': 'waybill_id'}"/>
                    <filter string="By Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="By Owner" name="group_owner" context="{'group_by': 'process_owner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_logistics_trace_exception" model="ir.actions.act_window">
        <field name="name">Exceptions</field>
        <field name="res_model">logistics.trace.exception</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_logistics_trace_exception_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No active exceptions right now.
            </p>
            <p>
                Create a new exception, or remove the default <strong>Active</strong> filter to review history.
            </p>
        </field>
    </record>

    <menuitem id="menu_logistics_trace_exception" name="Exceptions" parent="logistics_dispatch.menu_logistics_dispatch" action="action_logistics_trace_exception" sequence="60"/>

    <record id="view_logistics_dispatch_waybill_form_inherit_trace_exception" model="ir.ui.view">
        <field name="name">logistics.dispatch.waybill.form.trace.exception</field>
        <field name="model">logistics.dispatch.waybill</field>
        <field name="inherit_id" ref="logistics_dispatch.view_logistics_dispatch_waybill_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[last()]" position="after">
                <button name="action_open_exceptions" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                    <field name="open_exception_count" string="Open Exceptions" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
