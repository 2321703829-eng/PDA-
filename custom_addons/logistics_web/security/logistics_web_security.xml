<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_logistics_driver_management_viewer" model="res.groups">
        <field name="name">司机管理查看</field>
        <field name="comment">可查看司机管理入口、列表、画像和下钻。</field>
        <field name="sequence">210</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_driver_management_manager" model="res.groups">
        <field name="name">司机管理管理</field>
        <field name="comment">预留给司机管理后续编辑与调整动作，当前默认继承查看权限。</field>
        <field name="sequence">211</field>
        <field name="implied_ids" eval="[(4, ref('group_logistics_driver_management_viewer'))]"/>
    </record>

    <record id="group_logistics_analysis_viewer" model="res.groups">
        <field name="name">物流分析中心查看</field>
        <field name="comment">可查看统计图表中心、物流工作台和管理看板。</field>
        <field name="sequence">220</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_logistics_analysis_manager" model="res.groups">
        <field name="name">物流分析中心管理</field>
        <field name="comment">预留给分析中心后续管理动作，当前默认继承查看权限。</field>
        <field name="sequence">221</field>
        <field name="implied_ids" eval="[(4, ref('group_logistics_analysis_viewer'))]"/>
    </record>
</odoo>
